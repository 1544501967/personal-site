---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout title="关于 - Miro" description="关于我的个人介绍、技能和工作经历。">
  <section class="section-padding">
    <div class="section-container">
      <div class="max-w-3xl mx-auto">
        <!-- Intro -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-16">
          <div class="w-32 h-32 rounded-2xl bg-gradient-to-br from-primary to-primary-light flex items-center justify-center text-white text-4xl font-bold shrink-0">
            M
          </div>
          <div class="text-center sm:text-left">
            <h1 class="text-3xl font-bold mb-2">Miro</h1>
            <p class="text-text-muted text-lg mb-4">全栈 · AI 开发工程师</p>
            <p class="text-text-muted leading-relaxed">
              一名专注 AI 应用开发的工程师，热衷于把大模型与智能体技术落地到真实业务场景。
              擅长用 Python 构建智能体工作流，也熟悉前端开发与数据处理；
              工作之余喜欢探索新技术，在实战中沉淀经验、记录思考。
            </p>
            <div class="mt-4">
              <SocialLinks />
            </div>
          </div>
        </div>

        <!-- Skills -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold mb-6">技能</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {[
              {
                category: 'AI 应用开发',
                skills: ['Python', 'LangChain', 'LangGraph', 'RAG', 'Prompt 工程', '工具调用', 'MCP'],
              },
              {
                category: '机器学习',
                skills: ['LightGBM', 'XGBoost', 'YOLOv10', '数据预处理', '模型训练与调优'],
              },
              {
                category: '前端开发',
                skills: ['Vue', 'React', 'TypeScript', 'Astro', 'Tailwind CSS'],
              },
              {
                category: '后端与工具',
                skills: ['SQL', 'PostgreSQL', 'Docker', 'Git', 'n8n'],
              },
            ].map(({ category, skills }) => (
              <div class="card p-5">
                <h3 class="font-semibold text-sm text-primary mb-3">{category}</h3>
                <div class="flex flex-wrap gap-2">
                  {skills.map((skill) => (
                    <span class="tag">{skill}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Experience -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold mb-6">工作经历</h2>
          <div class="space-y-6">
            {[
              {
                role: 'AI 应用开发工程师',
                company: '杭州数鸢科技有限公司',
                period: '2025.06 - 至今',
                description: '负责电商场景智能体应用的设计与开发，围绕客服辅助、利润分析与爆品方案生成推进项目落地。基于 LangChain / LangGraph 搭建智能体工作流，完成意图识别、任务拆解、流程编排、工具调用与结果生成等核心能力建设。',
              },
              {
                role: 'Python 应用开发（实习）',
                company: '杭州四维映射软件有限公司',
                period: '2025.03 - 2025.06',
                description: '负责基于 YOLOv10 的电路元器件检测模型开发，完成数据增强、模型训练与超参数调优；设计从图像输入到拓扑输出的完整 pipeline，开发后处理算法将检测结果转化为电路节点图（Netlist），支撑下游仿真软件运行。',
              },
            ].map(({ role, company, period, description }) => (
              <div class="relative pl-6 border-l-2 border-primary/20">
                <div class="absolute left-[-5px] top-1 w-2 h-2 rounded-full bg-primary"></div>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-1">
                  <h3 class="font-semibold">{role}</h3>
                  <span class="text-sm text-text-muted">{period}</span>
                </div>
                <p class="text-sm text-primary font-medium mb-1">{company}</p>
                <p class="text-text-muted text-sm leading-relaxed">{description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Education -->
        <div>
          <h2 class="text-2xl font-bold mb-6">教育背景</h2>
          <div class="space-y-6">
            {[
              {
                school: '杭州师范大学',
                degree: '计算机科学与技术 本科',
                period: '2021年9月 - 2025年6月',
                description: '主修计算机组成原理、操作系统、计算机网络、数据结构与算法、数据库系统、人工智能基础等核心课程，并在 AI 应用与软件工程方向持续深入实践。',
              },
            ].map(({ school, degree, period, description }) => (
              <div class="relative pl-6 border-l-2 border-primary/20">
                <div class="absolute left-[-5px] top-1 w-2 h-2 rounded-full bg-primary"></div>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-1">
                  <h3 class="font-semibold">{school}</h3>
                  <span class="text-sm text-text-muted">{period}</span>
                </div>
                <p class="text-sm text-primary font-medium mb-1">{degree}</p>
                <p class="text-text-muted text-sm leading-relaxed">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
